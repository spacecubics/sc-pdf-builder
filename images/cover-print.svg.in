<svg xmlns="http://www.w3.org/2000/svg" width="595" height="842" viewBox="0 0 595 842">
  <rect width="595" height="842" fill="#ffffff"/>
  <rect width="595" height="52" fill="#414551" opacity="0.07"/>
  <text x="48" y="32" fill="#414551" opacity="0.95" font-family="Noto Sans JP" font-size="11" font-weight="bold" letter-spacing="0.6">@CONFIDENTIAL_LABEL@</text>
  <text x="547" y="32" fill="#414551" opacity="0.9" font-family="Noto Sans JP" font-size="10" letter-spacing="1.2" text-anchor="end">@DOCUMENT_NUMBER@</text>
  <text x="51" y="218" fill="#414551" opacity="0.95" font-family="Noto Sans JP" font-size="18">@PRODUCT_NAME@</text>

  <g fill="#414551" opacity="0.92" font-family="Noto Sans JP" font-size="9.5" letter-spacing="1">
    <text x="48" y="726">@FIELD_1_LABEL@:  @FIELD_1_VALUE@</text>
    <text x="48" y="748">@FIELD_2_LABEL@:  @FIELD_2_VALUE@</text>
  </g>
  <line x1="48" y1="768" x2="547" y2="768" stroke="#414551" stroke-width="1.5" opacity="0.4"/>
  <text x="48" y="791" fill="#414551" opacity="0.95" font-family="Noto Sans JP" font-size="9.5" letter-spacing="1">@COVER_FOOTER_TEXT@</text>
</svg>
